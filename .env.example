# Copy to .env.local. Never commit real values.

# Supabase (from `supabase start` locally, or the project dashboard)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Cron only. Bypasses RLS entirely, so it is deliberately NOT NEXT_PUBLIC_:
# a client-side import must fail loudly rather than ship the key.
# Used by app/api/cron/* to write prices / series_points / ingest_watermarks.
SUPABASE_SERVICE_ROLE_KEY=

# Where password-reset links land. Taken from here, never from the Host header.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Vercel cron authentication. Required; at least 32 random bytes. Generate with:
# openssl rand -base64 32
CRON_SECRET=

# Pack source keys — OPTIONAL. Absent key = source disabled, instruments show
# as unpriced with a reason, nothing crashes (PACKS.md §7). Ingestion treats a
# missing variable as a preflight skip: no adapter call, and `last_error` names
# the variable.
#
# br.brapi — free tier at https://brapi.dev/. NOTE: the free plan caps
# historical range at 3 months and returns HTTP 400 beyond it.
BRAPI_TOKEN=

# `pnpm fixtures:record` reads the keys above to record HTTP fixtures. It never
# reads a user's portfolio: fixture inputs come from the checked-in catalog in
# scripts/fixture-catalog.ts, and secrets are redacted before anything is written.

# --- test tiers -------------------------------------------------------------
# The performance budgets (MILESTONES.md §4 decision 44) are opt-in: they seed
# a five-year ledger and build ~1,250 snapshot days, which takes minutes.
# Unset, `pnpm test:db` skips them. Set to 1 to measure:
#   FF_BUDGETS=1 pnpm test:db      → docs/performance-budgets.md
FF_BUDGETS=

# `pnpm test:e2e` reads the same Supabase variables as the database tier, plus
# NEXT_PUBLIC_SITE_URL. It starts its own server and runs OFFLINE: the server
# is started without BRAPI_TOKEN so no journey can reach a live source
# (playwright.config.ts).
