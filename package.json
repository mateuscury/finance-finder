{
  "name": "finance-finder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:calc": "vitest run lib/calc",
    "test:packs": "vitest run packs",
    "test:db": "vitest run --config vitest.db.config.mts",
    "test:e2e": "playwright test",
    "codeowners": "tsx scripts/generate-codeowners.ts",
    "bootstrap:user": "tsx --env-file-if-exists=.env.local scripts/bootstrap-user.ts",
    "release:check": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:db && pnpm codeowners --check && tsx scripts/check-release-readiness.ts && pnpm test:e2e && pnpm build",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > lib/database.types.ts",
    "fixtures:record": "tsx --env-file-if-exists=.env.local scripts/record-fixtures.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "decimal.js": "^10.6.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "fast-check": "^4.10.2",
    "prettier": "3.9.8",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  }
}
